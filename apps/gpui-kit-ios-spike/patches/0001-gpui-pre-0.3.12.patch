diff -ruN a/Cargo.toml b/Cargo.toml
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -50,7 +50,6 @@
 media_session = []
 # Render GPUI windows into images (`gpui_mobile::offscreen`). Needs the vendored
 # `gpui-pre-wgpu` (see `[patch.crates-io]`), which exposes its headless renderer.
-offscreen = ["gpui_wgpu/offscreen", "dep:image"]
 
 [lib]
 name = "gpui_mobile"
@@ -68,7 +67,7 @@
 image        = { version = "0.25", default-features = false, optional = true }
 
 # ── GPUI core crate (provides Platform trait, event types, geometry, etc.) ───
-gpui = { package = "gpui-pre", version = "=0.3.10", default-features = false }
+gpui = { package = "gpui-pre", version = "=0.3.12", default-features = false }
 
 # ── iOS ──────────────────────────────────────────────────────────────────────
 
@@ -91,7 +90,7 @@
 libc = "=0.2.189"
 
 # wgpu renderer (Metal backend on iOS/Android)
-gpui_wgpu = { package = "gpui-pre-wgpu", version = "=0.3.10", features = ["font-kit"] }
+gpui_wgpu = { package = "gpui-pre-wgpu", version = "=0.3.12", features = ["font-kit"] }
 wgpu = "30.0.1"
 
 # Text / font stack
@@ -122,7 +121,7 @@
 
 # wgpu renderer (Vulkan backend on Android)
 # Android uses Cosmic Text and system fonts; font-kit pulls in desktop Fontconfig.
-gpui_wgpu = { package = "gpui-pre-wgpu", version = "=0.3.10" }
+gpui_wgpu = { package = "gpui-pre-wgpu", version = "=0.3.12" }
 
 # TalkBack: exposes GPUI's AccessKit tree (accesskit 0.24, as gpui-pre).
 accesskit_android = "0.7.5"
@@ -134,7 +133,7 @@
 # ── dev ──────────────────────────────────────────────────────────────────────
 
 [dev-dependencies]
-gpui = { package = "gpui-pre", version = "=0.3.10", default-features = false, features = ["test-support"] }
+gpui = { package = "gpui-pre", version = "=0.3.12", default-features = false, features = ["test-support"] }
 
 # ── profiles ─────────────────────────────────────────────────────────────────
 
@@ -153,5 +152,3 @@
 # instance (iOS needs Metal), and methods that release its render target and
 # clear its sprite atlas between captures. Applications that enable `offscreen`
 # must patch it the same way.
-[patch.crates-io]
-gpui-pre-wgpu = { path = "vendor/gpui-pre-wgpu" }
