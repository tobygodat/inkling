#!/bin/bash
# SKETCH: feedback/ship.sh (new). Lives next to the records it writes.
#
# Ships one feedback from the standing checkout: checks, record, commit to main, install.
# Run by the feedback agent after it has made the change (or decided not to).
#
# Usage:
#   feedback/ship.sh done     <id> "<one-line summary of what changed>"
#   feedback/ship.sh declined <id> "<one-line reason>"
#
#   <id> is the feedback id from the webhook body, e.g. 1762899330-k7q2m9xd.
#   The line is what the writer reads in Feedback & fixes: plain words, at most 160 chars.
#
# Exit: 0 shipped (or already shipped and now installed). 1 a step failed; the message names
# the step and the fix. 2 bad usage or a checkout ship.sh won't touch.
#
# Safe to run twice, and to rerun after a crash at any point: every step reads the state that
# exists (is the record committed? is the tree clean?) instead of trusting what a previous run
# meant to do. See "Crash table" at the bottom.
#
# Cost on a warm target/: record ~1 s, tests ~2 s, clippy ~1 s, snap 23-28 s, commit <1 s,
# install 2-5 s. Nothing here adds a stage beyond what CLAUDE.md already requires.

set -euo pipefail
export PATH=/opt/homebrew/opt/rustup/bin:$PATH
cd "$(dirname "$0")/.."

# ── 0. usage ─────────────────────────────────────────────────────────────────────────────
# outcome=$1 (done|declined) id=$2 line=$3, exactly three args, else usage → exit 2.
# The id and line are validated by the record writer (step 2), the one parser; bash only
# checks the id against ^[0-9]{1,20}-[a-z2-7]{8}$ so it is safe to use in a path.

# ── 1. preflight ─────────────────────────────────────────────────────────────────────────
# lock:    mkdir target/ship.lock (pid inside). If it exists and that pid is alive → exit 2
#          "another ship.sh is running (pid N)". A dead pid is a stale lock: take it over.
#          trap removes it on exit. (One feedback at a time, enforced, not hoped for.)
# branch:  `git symbolic-ref --short HEAD` must be main, with no merge/rebase in progress,
#          else exit 2. ship.sh commits straight to main by design (decision 13).
# others:  `git status --porcelain -- feedback/` may list only feedback/$id.json. Any other
#          uncommitted record → exit 2 "feedback/<other>.json is from another ship; finish
#          or delete it first". Stops one crashed ship from riding along in the next commit.
# shipped: committed=$(git cat-file -e "HEAD:feedback/$id.json" && echo yes)
#          If yes: print the committed record and skip to step 5. The committed record
#          wins; a rerun with different words does not rewrite history.

# ── 2. record ────────────────────────────────────────────────────────────────────────────
# cargo run -q -p inkling-core --example feedback-record -- "$outcome" "$id" "$line"
#   writes feedback/$id.json via tmp + rename, seconds_to_ship = now − the id's send time.
#   A rerun before commit rewrites it (fresh seconds, possibly new words): it's uncommitted.
#   Written BEFORE the checks so `cargo test` builds inkling-core with it, and core/build.rs
#   proves the app can read it. A bad record fails here, not after the commit.

# ── 3. checks ────────────────────────────────────────────────────────────────────────────
# step "tests"  cargo test --workspace
# step "clippy" cargo clippy --workspace --all-targets --all-features -- -D warnings
# step "snap"   mac/snap.sh            (rewrites docs/screenshots/mac/, committed in step 4)
# Each prints "== <step>" first and, on failure, "ship.sh: <step> failed; fix it and rerun
# feedback/ship.sh $outcome $id \"…\"". The record stays in the tree for the rerun.
# The same checks run for `declined`: the record alone changes the app.

# ── 4. commit ────────────────────────────────────────────────────────────────────────────
# git add -A        (the change, docs/screenshots/mac/, and feedback/$id.json)
# git commit -F -   message:
#     done:     "<summary> (feedback <id>)"
#     declined: "Decline feedback <id>"  with the reason as the body
#   trailers:   "Feedback: <id>"  and the Co-Authored-By line the agent's harness requires.
# After this, HEAD has the record, so every later rerun goes 1 → 5.

# ── 5. install ───────────────────────────────────────────────────────────────────────────
# mac/install.sh    builds release with INKLING_BUILD=$(git rev-list --count HEAD), writes the
#                   same number to CFBundleVersion, signs, replaces /Applications/Inkling.app.
#                   Never opens it. Idempotent: the same commit makes the same build number.
# The running app sees CFBundleVersion > its own build within 5 s and offers Restart.
# print "shipped $id ($outcome) as build N"

# ── (not done) push ──────────────────────────────────────────────────────────────────────
# OPEN QUESTION: should ship.sh `git push origin main` here so CI runs on each shipped commit?

# ── crash table ──────────────────────────────────────────────────────────────────────────
# crashed during …      the rerun finds …                         and does …
# 1 preflight           nothing changed                           everything
# 2 record              no file, the old file or the new file     rewrites it, continues
# 3 checks              the record uncommitted                    rewrites it, reruns checks
# 4 commit (before)     same as 3                                 same as 3
# 4 commit (after)      HEAD has the record                       skips to install
# 5 install             HEAD has the record; bundle old/missing   installs (rm + ditto again)
# success               HEAD has the record; bundle current       installs again (same build)

# ─────────────────────────────────────────────────────────────────────────────────────────
# Change to mac/install.sh (two lines):
#   version: read inkling-core's version, the one `Build::version` reports, not inkling-mac's.
#   build:   `INKLING_BUILD="$build" cargo build --release -p inkling-mac`, so the binary and
#            Info.plist get the same number from one variable.
# ─────────────────────────────────────────────────────────────────────────────────────────
#
# Example record (feedback/1762899330-k7q2m9xd.json; see design/tob-435/feedback/):
#
# {
#   "id": "1762899330-k7q2m9xd",
#   "outcome": "done",
#   "summary": "The page margins are 32 pt wider on the Mac.",
#   "seconds_to_ship": 412
# }
#
# and a declined one:
#
# {
#   "id": "1762899871-p4w2c6ta",
#   "outcome": "declined",
#   "reason": "The title is already 36 pt, the largest DESIGN.md allows.",
#   "seconds_to_ship": 95
# }
