diff -ruN a/src/ios/window/accessibility.rs b/src/ios/window/accessibility.rs
--- a/src/ios/window/accessibility.rs
+++ b/src/ios/window/accessibility.rs
@@ -0,0 +1,470 @@
+//! UIKit accessibility for the AccessKit tree GPUI builds for the window.
+//!
+//! GPUI builds the tree only while the platform says it is active, so it
+//! costs nothing until something reads it. It is active while VoiceOver or
+//! Switch Control runs, when `GPUI_A11Y_ACTIVE=1` is set, and after UIKit
+//! asks the GPUI view for its accessibility elements, as an XCTest snapshot
+//! does. Turned on by such a question alone, it turns off again once
+//! [`IDLE`] passes without another.
+//!
+//! Each update is flattened into the elements UIKit reads off the GPUI view:
+//! one per control, input, image, heading or labelled text, in tree order,
+//! with its label, value, traits and frame. Container nodes give no element
+//! of their own, and a control's descendants none either: they make its
+//! label when it has none. Text runs belong to their input. The focused text
+//! input is the bridge's own `GPUITextInputView` rather than an element, so
+//! UIKit keeps reading the document, the caret and the typing from it. The
+//! GPUI view's other subviews follow, as UIKit found them before.
+//!
+//! An element does nothing of its own when activated: VoiceOver taps its
+//! centre, which GPUI handles as a finger's tap.
+
+use super::IosWindow;
+use crate::ios::cg_types::ObjcCGRect;
+use crate::ios::util::nsstring;
+use gpui::accesskit::{Node, NodeId, Role, Toggled, TreeUpdate};
+use gpui::A11yCallbacks;
+use objc2::runtime::{AnyObject, Bool};
+use objc2::{class, msg_send};
+use std::cell::{Cell, RefCell};
+use std::collections::HashMap;
+use std::ptr;
+use std::time::{Duration, Instant};
+
+type Id = *mut AnyObject;
+
+/// How long the tree stays on after the last question from UIKit, while no
+/// screen reader or switch runs.
+const IDLE: Duration = Duration::from_secs(30);
+
+#[link(name = "UIKit", kind = "framework")]
+unsafe extern "C" {
+    fn UIAccessibilityIsVoiceOverRunning() -> Bool;
+    fn UIAccessibilityIsSwitchControlRunning() -> Bool;
+    fn UIAccessibilityPostNotification(notification: u32, argument: Id);
+    fn UIAccessibilityConvertFrameToScreenCoordinates(rect: ObjcCGRect, view: Id) -> ObjcCGRect;
+    static UIAccessibilityLayoutChangedNotification: u32;
+    static UIAccessibilityVoiceOverStatusDidChangeNotification: Id;
+    static UIAccessibilitySwitchControlStatusDidChangeNotification: Id;
+    static UIAccessibilityTraitButton: u64;
+    static UIAccessibilityTraitLink: u64;
+    static UIAccessibilityTraitImage: u64;
+    static UIAccessibilityTraitSelected: u64;
+    static UIAccessibilityTraitStaticText: u64;
+    static UIAccessibilityTraitNotEnabled: u64;
+    static UIAccessibilityTraitSearchField: u64;
+    static UIAccessibilityTraitHeader: u64;
+}
+
+/// Whether a screen reader or a switch is reading the screen now.
+fn assistive_technology_running() -> bool {
+    unsafe { UIAccessibilityIsVoiceOverRunning().as_bool() || UIAccessibilityIsSwitchControlRunning().as_bool() }
+}
+
+/// `GPUI_A11Y_ACTIVE=1`: build the tree from launch, as a screen reader would.
+fn forced() -> bool {
+    static FORCED: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *FORCED.get_or_init(|| std::env::var("GPUI_A11Y_ACTIVE").is_ok_and(|value| value == "1"))
+}
+
+/// What one node shows UIKit.
+#[derive(Clone, Copy, PartialEq)]
+enum Kind {
+    Button,
+    Link,
+    Input,
+    Search,
+    Image,
+    Heading,
+    Text,
+}
+
+/// One element UIKit reads, flattened from the tree.
+#[derive(Clone, PartialEq)]
+struct Exposed {
+    id: NodeId,
+    kind: Kind,
+    label: Option<String>,
+    value: Option<String>,
+    identifier: Option<String>,
+    selected: bool,
+    disabled: bool,
+    /// In the GPUI view's points.
+    frame: [f64; 4],
+    /// The focused input, which UIKit reads from the text input view.
+    focused_input: bool,
+}
+
+impl Exposed {
+    fn traits(&self) -> u64 {
+        unsafe {
+            let kind = match self.kind {
+                Kind::Button => UIAccessibilityTraitButton,
+                Kind::Link => UIAccessibilityTraitLink,
+                Kind::Image => UIAccessibilityTraitImage,
+                Kind::Heading => UIAccessibilityTraitHeader,
+                Kind::Search => UIAccessibilityTraitSearchField,
+                Kind::Text => UIAccessibilityTraitStaticText,
+                Kind::Input => 0,
+            };
+            let selected = if self.selected { UIAccessibilityTraitSelected } else { 0 };
+            let disabled = if self.disabled { UIAccessibilityTraitNotEnabled } else { 0 };
+            kind | selected | disabled
+        }
+    }
+
+    fn frame(&self) -> ObjcCGRect {
+        let [x, y, width, height] = self.frame;
+        ObjcCGRect { x, y, width, height }
+    }
+}
+
+/// The window's accessibility: GPUI's callbacks, the last tree flattened,
+/// and the elements UIKit was given for it.
+#[derive(Default)]
+pub(super) struct Accessibility {
+    callbacks: RefCell<Option<A11yCallbacks>>,
+    active: Cell<bool>,
+    exposed: RefCell<Vec<Exposed>>,
+    /// The elements are behind `exposed`.
+    stale: Cell<bool>,
+    /// The elements by node, kept across updates so VoiceOver's cursor stays
+    /// on the same object. Each is retained here.
+    elements: RefCell<HashMap<NodeId, Id>>,
+    /// What UIKit reads: the elements in order, then the view's subviews.
+    /// Retained here; null until first asked for.
+    array: Cell<Id>,
+    /// Whether the text input view was first responder when `array` was
+    /// made. UIKit makes it so a turn after GPUI focuses an input, with no
+    /// new tree to follow.
+    array_input_first: Cell<bool>,
+    asked_at: Cell<Option<Instant>>,
+}
+
+impl Accessibility {
+    /// `PlatformWindow::a11y_init`.
+    pub(super) fn init(&self, callbacks: A11yCallbacks) {
+        *self.callbacks.borrow_mut() = Some(callbacks);
+        observe_status();
+        self.status_changed();
+    }
+
+    fn wanted(&self) -> bool {
+        forced()
+            || assistive_technology_running()
+            || self.asked_at.get().is_some_and(|at| at.elapsed() < IDLE)
+    }
+
+    /// VoiceOver or Switch Control started or stopped.
+    pub(super) fn status_changed(&self) {
+        if self.wanted() {
+            self.activate();
+        } else {
+            self.deactivate();
+        }
+    }
+
+    fn activate(&self) {
+        if self.active.replace(true) {
+            return;
+        }
+        // GPUI answers with a bare root and draws a frame, whose tree comes next.
+        if let Some(callbacks) = self.callbacks.borrow().as_ref() {
+            let _ = (callbacks.activation)();
+        }
+    }
+
+    fn deactivate(&self) {
+        if !self.active.replace(false) {
+            return;
+        }
+        if let Some(callbacks) = self.callbacks.borrow().as_ref() {
+            (callbacks.deactivation)();
+        }
+    }
+
+    /// `PlatformWindow::a11y_tree_update`, after each frame while active.
+    pub(super) fn update(&self, window: &IosWindow, tree: TreeUpdate) {
+        if !self.wanted() {
+            self.deactivate();
+            return;
+        }
+        let Some(exposed) = flatten(&tree, window.scale_factor.get()) else {
+            return;
+        };
+        if *self.exposed.borrow() == exposed {
+            return;
+        }
+        let moved = {
+            let old = self.exposed.borrow();
+            old.len() != exposed.len() || old.iter().zip(&exposed).any(|(a, b)| a.id != b.id)
+        };
+        *self.exposed.borrow_mut() = exposed;
+        self.stale.set(true);
+        // A screen reader holds on to the elements; give it the new ones now
+        // and say when they are different ones. A snapshot asks again.
+        if assistive_technology_running() {
+            unsafe { self.sync(window) };
+            if moved {
+                unsafe { UIAccessibilityPostNotification(UIAccessibilityLayoutChangedNotification, ptr::null_mut()) };
+            }
+        }
+    }
+
+    /// The GPUI view's `accessibilityElements`.
+    pub(super) fn elements(&self, window: &IosWindow) -> Id {
+        self.asked_at.set(Some(Instant::now()));
+        self.activate();
+        unsafe {
+            let input_first: Bool = msg_send![window.text_input.view, isFirstResponder];
+            if self.stale.get() || self.array.get().is_null() || self.array_input_first.get() != input_first.as_bool() {
+                self.sync(window);
+            }
+            let array: Id = msg_send![self.array.get(), retain];
+            msg_send![array, autorelease]
+        }
+    }
+
+    /// Bring the elements up to `exposed`.
+    unsafe fn sync(&self, window: &IosWindow) {
+        unsafe {
+            let view = window.view;
+            let input = window.text_input.view;
+            let input_first: Bool = msg_send![input, isFirstResponder];
+            let input_first = input_first.as_bool();
+            let array: Id = msg_send![class!(NSMutableArray), new];
+            let mut old = self.elements.take();
+            let mut kept = HashMap::new();
+            let mut placed_input = false;
+            for exposed in self.exposed.borrow().iter() {
+                if exposed.focused_input && input_first && !placed_input {
+                    let frame = UIAccessibilityConvertFrameToScreenCoordinates(exposed.frame(), view);
+                    let _: () = msg_send![input, setAccessibilityFrame: frame];
+                    let _: () = msg_send![array, addObject: input];
+                    placed_input = true;
+                    continue;
+                }
+                let element = old.remove(&exposed.id).unwrap_or_else(|| {
+                    let element: Id = msg_send![class!(UIAccessibilityElement), alloc];
+                    msg_send![element, initWithAccessibilityContainer: view]
+                });
+                describe(element, exposed);
+                let _: () = msg_send![array, addObject: element];
+                kept.insert(exposed.id, element);
+            }
+            for (_, element) in old {
+                let _: () = msg_send![element, release];
+            }
+            *self.elements.borrow_mut() = kept;
+            // An input with no node of its own (or before the first tree)
+            // still reads as UIKit's text input.
+            if input_first && !placed_input {
+                let _: () = msg_send![array, addObject: input];
+            }
+            let subviews: Id = msg_send![view, subviews];
+            let count: usize = msg_send![subviews, count];
+            for i in 0..count {
+                let subview: Id = msg_send![subviews, objectAtIndex: i];
+                if subview != input {
+                    let _: () = msg_send![array, addObject: subview];
+                }
+            }
+            let previous = self.array.replace(array);
+            if !previous.is_null() {
+                let _: () = msg_send![previous, release];
+            }
+            self.array_input_first.set(input_first);
+            self.stale.set(false);
+        }
+    }
+}
+
+impl Drop for Accessibility {
+    fn drop(&mut self) {
+        unsafe {
+            for (_, element) in self.elements.take() {
+                let _: () = msg_send![element, release];
+            }
+            let array = self.array.get();
+            if !array.is_null() {
+                let _: () = msg_send![array, release];
+            }
+        }
+    }
+}
+
+unsafe fn describe(element: Id, exposed: &Exposed) {
+    unsafe {
+        let string = |text: &Option<String>| text.as_deref().map_or(ptr::null_mut(), |text| nsstring(text));
+        let _: () = msg_send![element, setIsAccessibilityElement: Bool::YES];
+        let _: () = msg_send![element, setAccessibilityLabel: string(&exposed.label)];
+        let _: () = msg_send![element, setAccessibilityValue: string(&exposed.value)];
+        let _: () = msg_send![element, setAccessibilityIdentifier: string(&exposed.identifier)];
+        let _: () = msg_send![element, setAccessibilityTraits: exposed.traits()];
+        let _: () = msg_send![element, setAccessibilityFrameInContainerSpace: exposed.frame()];
+    }
+}
+
+/// Hear VoiceOver and Switch Control start and stop, once for the app.
+fn observe_status() {
+    static OBSERVING: std::sync::Once = std::sync::Once::new();
+    OBSERVING.call_once(|| unsafe {
+        let center: Id = msg_send![class!(NSNotificationCenter), defaultCenter];
+        let block = block2::RcBlock::new(|_: Id| {
+            if let Some(windows) = crate::ios::ffi::IOS_WINDOW_LIST.get() {
+                for &window in (*windows.0.get()).iter() {
+                    if !window.is_null() {
+                        (*window).accessibility.status_changed();
+                    }
+                }
+            }
+        });
+        for name in [UIAccessibilityVoiceOverStatusDidChangeNotification, UIAccessibilitySwitchControlStatusDidChangeNotification] {
+            let _: Id = msg_send![center,
+                addObserverForName: name,
+                object: ptr::null::<AnyObject>(),
+                queue: ptr::null::<AnyObject>(),
+                usingBlock: &*block
+            ];
+        }
+        // It lives as long as the app.
+        std::mem::forget(block);
+    });
+}
+
+/// The elements a tree shows, in order, or `None` for an update that is not
+/// a whole tree.
+fn flatten(tree: &TreeUpdate, scale: f32) -> Option<Vec<Exposed>> {
+    let root = tree.tree.as_ref()?.root;
+    let nodes: HashMap<NodeId, &Node> = tree.nodes.iter().map(|(id, node)| (*id, node)).collect();
+    let mut out = Vec::new();
+    walk(root, &nodes, tree.focus, f64::from(scale.max(1.0)), &mut out);
+    Some(out)
+}
+
+fn walk(id: NodeId, nodes: &HashMap<NodeId, &Node>, focus: NodeId, scale: f64, out: &mut Vec<Exposed>) {
+    let Some(node) = nodes.get(&id) else {
+        return;
+    };
+    if node.is_hidden() {
+        return;
+    }
+    let role = node.role();
+    let kind = match role {
+        Role::TextRun => return,
+        Role::Button
+        | Role::DefaultButton
+        | Role::CheckBox
+        | Role::Switch
+        | Role::RadioButton
+        | Role::Tab
+        | Role::MenuItem
+        | Role::MenuItemCheckBox
+        | Role::MenuItemRadio
+        | Role::MenuListOption
+        | Role::ListBoxOption
+        | Role::TreeItem
+        | Role::ComboBox
+        | Role::DisclosureTriangle => Some(Kind::Button),
+        Role::Link => Some(Kind::Link),
+        Role::SearchInput => Some(Kind::Search),
+        Role::TextInput
+        | Role::MultilineTextInput
+        | Role::EditableComboBox
+        | Role::EmailInput
+        | Role::NumberInput
+        | Role::PasswordInput
+        | Role::PhoneNumberInput
+        | Role::UrlInput => Some(Kind::Input),
+        Role::Image => Some(Kind::Image),
+        Role::Heading => Some(Kind::Heading),
+        Role::Label | Role::Paragraph => Some(Kind::Text),
+        _ => None,
+    };
+    if let Some(kind) = kind {
+        let mut label = node.label().or(node.placeholder()).map(str::to_string);
+        if label.is_none() && kind != Kind::Input {
+            label = text_of(id, nodes);
+        }
+        // A password's value is its secret.
+        let value = if role == Role::PasswordInput {
+            None
+        } else {
+            node.value().map(str::to_string).or_else(|| match node.toggled() {
+                Some(Toggled::True) => Some("1".into()),
+                Some(Toggled::False) => Some("0".into()),
+                _ => None,
+            })
+        };
+        push(out, id, node, kind, label, value, focus, scale);
+        // A control's descendants are its label. An input's are its runs,
+        // already its value, and what it draws among them, such as formulas
+        // and images, which are read after it.
+        if kind != Kind::Input {
+            return;
+        }
+    }
+    let before = out.len();
+    for child in node.children() {
+        walk(*child, nodes, focus, scale, out);
+    }
+    // A labelled group with nothing readable inside (an alert, a status)
+    // reads as its label.
+    if kind.is_none() && out.len() == before && role != Role::Window {
+        let label = node.label().map(str::to_string);
+        let value = node.value().map(str::to_string);
+        if label.is_some() || value.is_some() {
+            push(out, id, node, Kind::Text, label, value, focus, scale);
+        }
+    }
+}
+
+#[allow(clippy::too_many_arguments)]
+fn push(
+    out: &mut Vec<Exposed>,
+    id: NodeId,
+    node: &Node,
+    kind: Kind,
+    label: Option<String>,
+    value: Option<String>,
+    focus: NodeId,
+    scale: f64,
+) {
+    // A node with no place on screen cannot be found or tapped.
+    let Some(bounds) = node.bounds() else {
+        return;
+    };
+    let frame = [bounds.x0 / scale, bounds.y0 / scale, (bounds.x1 - bounds.x0) / scale, (bounds.y1 - bounds.y0) / scale];
+    if frame[2] <= 0.0 || frame[3] <= 0.0 {
+        return;
+    }
+    out.push(Exposed {
+        id,
+        kind,
+        label,
+        value,
+        identifier: node.author_id().map(str::to_string),
+        selected: node.is_selected() == Some(true) || node.toggled() == Some(Toggled::True),
+        disabled: node.is_disabled(),
+        frame,
+        focused_input: kind == Kind::Input && id == focus,
+    });
+}
+
+/// A control's text, from the labels and values beneath it.
+fn text_of(id: NodeId, nodes: &HashMap<NodeId, &Node>) -> Option<String> {
+    let mut parts = Vec::new();
+    let mut stack: Vec<NodeId> = nodes.get(&id).map(|node| node.children().iter().rev().copied().collect()).unwrap_or_default();
+    while let Some(id) = stack.pop() {
+        let Some(node) = nodes.get(&id) else { continue };
+        if node.is_hidden() {
+            continue;
+        }
+        if let Some(text) = node.label().or(node.value()).filter(|text| !text.is_empty()) {
+            parts.push(text.to_string());
+            continue;
+        }
+        stack.extend(node.children().iter().rev());
+    }
+    (!parts.is_empty()).then(|| parts.join(" "))
+}
