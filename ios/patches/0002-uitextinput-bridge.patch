--- a/src/ios/window/text_input_view.rs
+++ b/src/ios/window/text_input_view.rs
@@ -0,0 +1,1158 @@
+//! A `UITextInput` view backed by GPUI's platform input handler.
+//!
+//! UIKit reads and edits the focused GPUI document through this view: the
+//! text around the caret, the selection, the marked range, and the geometry
+//! of each. That is what autocorrection, auto-capitalisation, predictive
+//! suggestions, marked text and dictation need. Every offset is a UTF-16
+//! index into the GPUI document, the same unit `PlatformInputHandler` uses.
+//!
+//! UIKit also has to hear about changes it did not make (a tap that moves the
+//! caret, a paste from GPUI's own menu, focus moving to another input), or it
+//! keeps suggesting against a stale document. [`IosWindow::sync_text_input`]
+//! compares the document with what UIKit last saw after each drawn frame and
+//! tells the keyboard's input delegate when they differ. Edits UIKit makes
+//! itself record what UIKit now sees, so they never echo back as outside
+//! changes; an echo would reset the keyboard and drop its corrections.
+
+use super::{IosWindow, GPUI_WINDOW_IVAR};
+use crate::ios::cg_types::{ObjcCGPoint, ObjcCGRect};
+use crate::ios::text_input::ObjcNSRange;
+use gpui::{
+    px, Autocapitalize, Bounds, FocusId, Pixels, PlatformInputHandler, TextInputAction,
+    TextInputConfiguration,
+};
+use objc2::runtime::{AnyClass, AnyObject, AnyProtocol, Bool, ClassBuilder, Sel};
+use objc2::{class, msg_send, sel};
+use std::cell::{Cell, RefCell};
+use std::ffi::c_void;
+use std::ops::Range;
+use std::ptr;
+
+const POSITION_OFFSET_IVAR: &str = "gpui_offset";
+const RANGE_START_IVAR: &str = "gpui_start";
+const RANGE_END_IVAR: &str = "gpui_end";
+const TOKENIZER_IVAR: &str = "gpui_tokenizer";
+
+/// What UIKit last saw of the focused document.
+#[derive(Clone, Debug, PartialEq)]
+pub(super) struct DocumentState {
+    focus: Option<FocusId>,
+    len: usize,
+    selection: Range<usize>,
+    marked: Option<Range<usize>>,
+}
+
+impl DocumentState {
+    /// A change UIKit must treat as new text rather than a moved caret.
+    fn text_differs(&self, other: &Self) -> bool {
+        self.focus != other.focus || self.len != other.len || self.marked != other.marked
+    }
+}
+
+/// The window's half of the bridge: the native view plus the state UIKit
+/// hands it. The view itself holds only a pointer back to the window.
+pub(super) struct TextInputSession {
+    pub(super) view: *mut AnyObject,
+    /// UIKit's `inputDelegate`. Weak, as UIKit expects; UIKit clears it.
+    delegate: Cell<*mut AnyObject>,
+    configuration: RefCell<TextInputConfiguration>,
+    keyboard_type: Cell<isize>,
+    seen: RefCell<Option<DocumentState>>,
+    drew: Cell<bool>,
+    /// Set while the input delegate hears about an outside change.
+    notifying: Cell<bool>,
+    /// UIKit's own selection UI (loupe, handles, edit menu), when attached.
+    interaction: Cell<*mut AnyObject>,
+}
+
+impl TextInputSession {
+    /// Create the view as a transparent, touch-transparent cover over `parent`,
+    /// so its coordinate space is GPUI's window space.
+    ///
+    /// # Safety
+    /// `parent` must be a live UIView, on the main thread.
+    pub(super) unsafe fn new(parent: *mut AnyObject) -> Self {
+        let class = register_view_class();
+        let view: *mut AnyObject = msg_send![class, alloc];
+        let frame: ObjcCGRect = msg_send![parent, bounds];
+        let view: *mut AnyObject = msg_send![view, initWithFrame: frame];
+        let _: () = msg_send![view, setAutoresizingMask: 18_usize];
+        let _: () = msg_send![view, setUserInteractionEnabled: false];
+        let clear: *mut AnyObject = msg_send![class!(UIColor), clearColor];
+        let _: () = msg_send![view, setBackgroundColor: clear];
+        let _: () = msg_send![parent, addSubview: view];
+        Self {
+            view,
+            delegate: Cell::new(ptr::null_mut()),
+            configuration: RefCell::new(TextInputConfiguration::default()),
+            keyboard_type: Cell::new(0),
+            seen: RefCell::new(None),
+            drew: Cell::new(false),
+            notifying: Cell::new(false),
+            interaction: Cell::new(ptr::null_mut()),
+        }
+    }
+
+    pub(super) fn set_keyboard_type(&self, keyboard_type: isize) {
+        self.keyboard_type.set(keyboard_type);
+    }
+
+    pub(super) fn set_configuration(&self, configuration: TextInputConfiguration) {
+        *self.configuration.borrow_mut() = configuration;
+        // Called from inside a GPUI frame. UIKit reads the document while it
+        // reloads, so let it reload once GPUI has returned.
+        self.after_this_turn(sel!(gpuiReloadIfFirstResponder));
+    }
+
+    pub(super) fn mark_drawn(&self) {
+        self.drew.set(true);
+    }
+
+    pub(super) fn become_first_responder(&self) {
+        self.after_this_turn(sel!(becomeFirstResponder));
+        self.after_this_turn(sel!(gpuiReloadIfFirstResponder));
+    }
+
+    /// Attach or detach UIKit's `UITextInteraction`, for apps that let the
+    /// system draw the selection UI instead of drawing their own.
+    pub(super) fn set_system_selection_ui(&self, enabled: bool) {
+        self.after_this_turn(if enabled {
+            sel!(gpuiAttachTextInteraction)
+        } else {
+            sel!(gpuiDetachTextInteraction)
+        });
+    }
+
+    pub(super) fn resign_first_responder(&self) {
+        self.after_this_turn(sel!(resignFirstResponder));
+    }
+
+    fn after_this_turn(&self, selector: Sel) {
+        unsafe {
+            let _: () = msg_send![self.view,
+                performSelector: selector,
+                withObject: ptr::null::<AnyObject>(),
+                afterDelay: 0.0_f64
+            ];
+        }
+    }
+}
+
+impl IosWindow {
+    /// Run `f` on the focused input's handler, or return `None` when nothing is
+    /// focused or GPUI is mid-update (the handler is lent out, or the app is
+    /// borrowed and the handler's own update would fail).
+    fn with_input_handler<R>(&self, f: impl FnOnce(&mut PlatformInputHandler) -> R) -> Option<R> {
+        let mut handler = self.input_handler.try_borrow_mut().ok()?;
+        handler.as_mut().map(f)
+    }
+
+    fn read_document_state(&self) -> Option<DocumentState> {
+        self.with_input_handler(|handler| {
+            let selection = handler.selected_text_range(false)?.range;
+            Some(DocumentState {
+                focus: handler.focus_id(),
+                len: document_len(handler),
+                selection,
+                marked: handler.marked_text_range(),
+            })
+        })
+        .flatten()
+    }
+
+    /// Apply an edit UIKit asked for, then record the result as seen by UIKit.
+    fn edit_from_uikit<R>(&self, f: impl FnOnce(&mut PlatformInputHandler) -> R) -> Option<R> {
+        let result = self.with_input_handler(f);
+        self.record_seen();
+        result
+    }
+
+    fn record_seen(&self) {
+        let state = self.read_document_state();
+        *self.text_input.seen.borrow_mut() = state;
+    }
+
+    /// Tell UIKit about document changes it did not make. Runs after a frame,
+    /// outside any GPUI update, because UIKit reads the document back
+    /// synchronously from inside these delegate calls.
+    pub(crate) fn sync_text_input(&self) {
+        if !self.text_input.drew.replace(false) {
+            return;
+        }
+        let now = self.read_document_state();
+        let before = self.text_input.seen.replace(now.clone());
+        if before == now {
+            return;
+        }
+        let delegate = self.text_input.delegate.get();
+        if delegate.is_null() {
+            return;
+        }
+        let text_changed = match (&before, &now) {
+            (Some(before), Some(now)) => before.text_differs(now),
+            _ => true,
+        };
+        let view = self.text_input.view;
+        self.text_input.notifying.set(true);
+        unsafe {
+            if text_changed {
+                let _: () = msg_send![delegate, textWillChange: view];
+                let _: () = msg_send![delegate, textDidChange: view];
+            } else {
+                let _: () = msg_send![delegate, selectionWillChange: view];
+                let _: () = msg_send![delegate, selectionDidChange: view];
+            }
+        }
+        self.text_input.notifying.set(false);
+    }
+
+    /// End any composition before a touch can move focus or the caret. UIKit
+    /// hears about it from the next [`Self::sync_text_input`].
+    pub(super) fn commit_composition(&self) {
+        self.with_input_handler(|handler| {
+            if handler.marked_text_range().is_some() {
+                handler.unmark_text();
+            }
+        });
+    }
+}
+
+fn document_len(handler: &mut PlatformInputHandler) -> usize {
+    if let Some(len) = handler.text_length_utf16() {
+        return len;
+    }
+    // Handlers clamp out-of-range offsets, so the adjusted range of an empty
+    // range past the end is the document's end.
+    let mut adjusted = None;
+    handler.text_for_range(usize::MAX..usize::MAX, &mut adjusted);
+    adjusted.map_or(0, |range| range.end)
+}
+
+// ── Objective-C plumbing ─────────────────────────────────────────────────────
+
+static REGISTER: std::sync::Once = std::sync::Once::new();
+
+fn register_view_class() -> &'static AnyClass {
+    REGISTER.call_once(|| unsafe {
+        register_position_class();
+        register_range_class();
+        register_selection_rect_class();
+        register_input_view_class();
+    });
+    class!(GPUITextInputView)
+}
+
+#[allow(deprecated)]
+unsafe fn window_of<'a>(this: *mut AnyObject) -> Option<&'a IosWindow> {
+    let window: *mut c_void = unsafe { *(*this).get_ivar(GPUI_WINDOW_IVAR) };
+    (!window.is_null()).then(|| unsafe { &*(window as *const IosWindow) })
+}
+
+unsafe fn ns_string_to_string(string: *mut AnyObject) -> String {
+    if string.is_null() {
+        return String::new();
+    }
+    let utf8: *const std::ffi::c_char = unsafe { msg_send![string, UTF8String] };
+    if utf8.is_null() {
+        return String::new();
+    }
+    unsafe { std::ffi::CStr::from_ptr(utf8) }
+        .to_string_lossy()
+        .into_owned()
+}
+
+/// `NSString` or `NSAttributedString`, as UIKit's marked-text calls pass either.
+unsafe fn text_of(object: *mut AnyObject) -> String {
+    if object.is_null() {
+        return String::new();
+    }
+    let attributed: Bool = unsafe { msg_send![object, isKindOfClass: class!(NSAttributedString)] };
+    let string = if attributed.as_bool() {
+        unsafe { msg_send![object, string] }
+    } else {
+        object
+    };
+    unsafe { ns_string_to_string(string) }
+}
+
+unsafe fn position(offset: usize) -> *mut AnyObject {
+    unsafe {
+        let position: *mut AnyObject = msg_send![class!(GPUITextPosition), new];
+        #[allow(deprecated)]
+        {
+            *(*position).get_mut_ivar::<usize>(POSITION_OFFSET_IVAR) = offset;
+        }
+        msg_send![position, autorelease]
+    }
+}
+
+unsafe fn text_range(range: Range<usize>) -> *mut AnyObject {
+    unsafe {
+        let object: *mut AnyObject = msg_send![class!(GPUITextRange), new];
+        #[allow(deprecated)]
+        {
+            *(*object).get_mut_ivar::<usize>(RANGE_START_IVAR) = range.start;
+            *(*object).get_mut_ivar::<usize>(RANGE_END_IVAR) = range.end;
+        }
+        msg_send![object, autorelease]
+    }
+}
+
+#[allow(deprecated)]
+unsafe fn offset_of(position: *mut AnyObject) -> Option<usize> {
+    if position.is_null() {
+        return None;
+    }
+    let ours: Bool = unsafe { msg_send![position, isKindOfClass: class!(GPUITextPosition)] };
+    ours.as_bool()
+        .then(|| unsafe { *(*position).get_ivar::<usize>(POSITION_OFFSET_IVAR) })
+}
+
+#[allow(deprecated)]
+unsafe fn range_of(range: *mut AnyObject) -> Option<Range<usize>> {
+    if range.is_null() {
+        return None;
+    }
+    let ours: Bool = unsafe { msg_send![range, isKindOfClass: class!(GPUITextRange)] };
+    ours.as_bool().then(|| unsafe {
+        let start = *(*range).get_ivar::<usize>(RANGE_START_IVAR);
+        let end = *(*range).get_ivar::<usize>(RANGE_END_IVAR);
+        start..end
+    })
+}
+
+fn cg_rect(bounds: Bounds<Pixels>) -> ObjcCGRect {
+    ObjcCGRect::new(
+        f32::from(bounds.origin.x) as f64,
+        f32::from(bounds.origin.y) as f64,
+        f32::from(bounds.size.width) as f64,
+        f32::from(bounds.size.height) as f64,
+    )
+}
+
+const NULL_RECT: ObjcCGRect = ObjcCGRect {
+    x: f64::INFINITY,
+    y: f64::INFINITY,
+    width: 0.0,
+    height: 0.0,
+};
+
+/// The rectangles a selection covers, one per visual line. Uses the handler's
+/// own selection geometry when it has any, else derives lines from the caret
+/// rectangles at each end and the element's bounds.
+fn selection_rects(handler: &mut PlatformInputHandler, range: Range<usize>) -> Vec<Bounds<Pixels>> {
+    let rects = handler.selection_bounds_for_range(range.clone());
+    if !rects.is_empty() {
+        return rects;
+    }
+    let (Some(start), Some(end)) = (
+        handler.bounds_for_range(range.start..range.start),
+        handler.bounds_for_range(range.end..range.end),
+    ) else {
+        return Vec::new();
+    };
+    if start.origin.y == end.origin.y {
+        return vec![Bounds::from_corners(start.origin, end.bottom_left())];
+    }
+    let Some(element) = handler.element_bounds() else {
+        return vec![Bounds::from_corners(start.origin, start.bottom_left())];
+    };
+    let mut rects = vec![Bounds::from_corners(
+        start.origin,
+        gpui::point(element.right(), start.bottom().max(start.top() + px(1.))),
+    )];
+    if end.top() > start.bottom() {
+        rects.push(Bounds::from_corners(
+            gpui::point(element.left(), start.bottom()),
+            gpui::point(element.right(), end.top()),
+        ));
+    }
+    rects.push(Bounds::from_corners(
+        gpui::point(element.left(), end.top()),
+        end.bottom_left(),
+    ));
+    rects
+}
+
+unsafe fn selection_rect(rect: ObjcCGRect, contains_start: bool, contains_end: bool) -> Id {
+    unsafe {
+        let object: Id = msg_send![class!(GPUITextSelectionRect), new];
+        #[allow(deprecated)]
+        {
+            *(*object).get_mut_ivar::<ObjcCGRect>("gpui_rect") = rect;
+            *(*object).get_mut_ivar::<Bool>("gpui_contains_start") = Bool::new(contains_start);
+            *(*object).get_mut_ivar::<Bool>("gpui_contains_end") = Bool::new(contains_end);
+        }
+        msg_send![object, autorelease]
+    }
+}
+
+unsafe fn register_selection_rect_class() {
+    let mut decl =
+        ClassBuilder::new(c"GPUITextSelectionRect", class!(UITextSelectionRect)).unwrap();
+    decl.add_ivar::<ObjcCGRect>(c"gpui_rect");
+    decl.add_ivar::<Bool>(c"gpui_contains_start");
+    decl.add_ivar::<Bool>(c"gpui_contains_end");
+
+    #[allow(deprecated)]
+    extern "C" fn rect(this: Id, _: Sel) -> ObjcCGRect {
+        unsafe { *(*this).get_ivar::<ObjcCGRect>("gpui_rect") }
+    }
+    #[allow(deprecated)]
+    extern "C" fn contains_start(this: Id, _: Sel) -> Bool {
+        unsafe { *(*this).get_ivar::<Bool>("gpui_contains_start") }
+    }
+    #[allow(deprecated)]
+    extern "C" fn contains_end(this: Id, _: Sel) -> Bool {
+        unsafe { *(*this).get_ivar::<Bool>("gpui_contains_end") }
+    }
+    extern "C" fn writing_direction(_: Id, _: Sel) -> isize {
+        0 // NSWritingDirectionLeftToRight
+    }
+    extern "C" fn is_vertical(_: Id, _: Sel) -> Bool {
+        Bool::NO
+    }
+
+    unsafe {
+        decl.add_method(sel!(rect), rect as extern "C" fn(_, _) -> _);
+        decl.add_method(
+            sel!(containsStart),
+            contains_start as extern "C" fn(_, _) -> _,
+        );
+        decl.add_method(sel!(containsEnd), contains_end as extern "C" fn(_, _) -> _);
+        decl.add_method(
+            sel!(writingDirection),
+            writing_direction as extern "C" fn(_, _) -> _,
+        );
+        decl.add_method(sel!(isVertical), is_vertical as extern "C" fn(_, _) -> _);
+    }
+    decl.register();
+}
+
+unsafe fn register_position_class() {
+    let mut decl = ClassBuilder::new(c"GPUITextPosition", class!(UITextPosition)).unwrap();
+    decl.add_ivar::<usize>(c"gpui_offset");
+    decl.register();
+}
+
+unsafe fn register_range_class() {
+    let mut decl = ClassBuilder::new(c"GPUITextRange", class!(UITextRange)).unwrap();
+    decl.add_ivar::<usize>(c"gpui_start");
+    decl.add_ivar::<usize>(c"gpui_end");
+
+    extern "C" fn start(this: *mut AnyObject, _: Sel) -> *mut AnyObject {
+        unsafe { position(range_of(this).unwrap_or_default().start) }
+    }
+    extern "C" fn end(this: *mut AnyObject, _: Sel) -> *mut AnyObject {
+        unsafe { position(range_of(this).unwrap_or_default().end) }
+    }
+    extern "C" fn is_empty(this: *mut AnyObject, _: Sel) -> Bool {
+        Bool::new(unsafe { range_of(this) }.is_none_or(|range| range.is_empty()))
+    }
+
+    unsafe {
+        decl.add_method(sel!(start), start as extern "C" fn(_, _) -> _);
+        decl.add_method(sel!(end), end as extern "C" fn(_, _) -> _);
+        decl.add_method(sel!(isEmpty), is_empty as extern "C" fn(_, _) -> _);
+    }
+    decl.register();
+}
+
+type Id = *mut AnyObject;
+
+// UITextLayoutDirection, plus UITextStorageDirectionBackward, which UIKit
+// passes through the same parameters.
+const BACKWARD: isize = 1;
+const RIGHT: isize = 2;
+const LEFT: isize = 3;
+const UP: isize = 4;
+const DOWN: isize = 5;
+
+fn towards_start(direction: isize) -> bool {
+    matches!(direction, BACKWARD | LEFT | UP)
+}
+
+unsafe fn register_input_view_class() {
+    let mut decl = ClassBuilder::new(c"GPUITextInputView", class!(UIView)).unwrap();
+    decl.add_ivar::<*mut c_void>(c"gpui_window_ptr");
+    decl.add_ivar::<Id>(c"gpui_tokenizer");
+    for protocol in [c"UIKeyInput", c"UITextInputTraits", c"UITextInput"] {
+        match AnyProtocol::get(protocol) {
+            Some(protocol) => {
+                decl.add_protocol(protocol);
+            }
+            None => log::error!("GPUI iOS: protocol {protocol:?} is not registered"),
+        }
+    }
+
+    // ── UIResponder ──────────────────────────────────────────────────────────
+
+    extern "C" fn can_become_first_responder(_: Id, _: Sel) -> Bool {
+        Bool::YES
+    }
+
+    extern "C" fn reload_if_first_responder(this: Id, _: Sel) {
+        unsafe {
+            let first: Bool = msg_send![this, isFirstResponder];
+            if first.as_bool() {
+                let _: () = msg_send![this, reloadInputViews];
+            }
+        }
+    }
+
+    // ── UIKeyInput ───────────────────────────────────────────────────────────
+
+    extern "C" fn has_text(this: Id, _: Sel) -> Bool {
+        let window = unsafe { window_of(this) };
+        let len = window.and_then(|window| window.with_input_handler(|h| document_len(h)));
+        // With no GPUI document the legacy text callbacks own the text; let
+        // Backspace through to them.
+        Bool::new(len.is_none_or(|len| len > 0))
+    }
+
+    extern "C" fn insert_text(this: Id, _: Sel, text: Id) {
+        let Some(window) = (unsafe { window_of(this) }) else {
+            return;
+        };
+        let string = unsafe { ns_string_to_string(text) };
+        let handled = window
+            .edit_from_uikit(|handler| handler.replace_text_in_range(None, &string))
+            .is_some();
+        if !handled {
+            window.handle_text_input(text);
+        }
+    }
