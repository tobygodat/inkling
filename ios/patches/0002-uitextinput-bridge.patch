+            let interaction: Id =
+                msg_send![class!(UITextInteraction), textInteractionForMode: 0_isize];
+            let _: () = msg_send![interaction, setTextInput: this];
+            let host: Id = msg_send![this, superview];
+            let _: () = msg_send![host, addInteraction: interaction];
+            let _: Id = msg_send![interaction, retain];
