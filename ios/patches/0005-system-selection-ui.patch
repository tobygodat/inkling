+    /// UIKit's edit menu asks its first responder which actions apply. Cut,
+    /// Copy, Paste and Select All run on the GPUI document; the rest stay
+    /// UIKit's.
+    extern "C" fn can_perform_action(this: Id, _: Sel, action: Sel, sender: Id) -> Bool {
+        let state = unsafe { window_of(this) }.and_then(|window| window.read_document_state());
+        if action == sel!(copy:) || action == sel!(cut:) {
+            return Bool::new(state.is_some_and(|state| !state.selection.is_empty()));
+        }
+        if action == sel!(paste:) {
+            return Bool::new(state.is_some());
+        }
+        if action == sel!(selectAll:) {
+            return Bool::new(
+                state.is_some_and(|state| state.len > 0 && state.selection != (0..state.len)),
+            );
+        }
+        unsafe { msg_send![super(this, class!(UIView)), canPerformAction: action, withSender: sender] }
+    }
