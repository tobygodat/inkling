+    /// Follow a touch on the GPUI view.
+    pub(super) fn touch(&self, phase: gpui::TouchPhase, position: gpui::Point<Pixels>) {
+        match phase {
+            gpui::TouchPhase::Started => self.contact.set(Some(Contact {
+                began: std::time::Instant::now(),
+                origin: position,
+                pan: false,
+            })),
+            gpui::TouchPhase::Moved => {
+                if let Some(mut contact) = self.contact.get() {
+                    let far = (position.x - contact.origin.x).abs() > px(10.)
+                        || (position.y - contact.origin.y).abs() > px(10.);
+                    if far && contact.began.elapsed() < LONG_PRESS {
+                        contact.pan = true;
+                        self.contact.set(Some(contact));
+                    }
+                }
+            }
+            gpui::TouchPhase::Ended | gpui::TouchPhase::Cancelled => self.contact.set(None),
+        }
+    }
+
+    /// Whether the finger down now is making a tap or a pan, which are
+    /// GPUI's: it has not rested long enough to be UIKit's long press.
+    fn gpui_owns_touch(&self) -> bool {
+        self.contact
+            .get()
+            .is_some_and(|contact| contact.pan || contact.began.elapsed() < LONG_PRESS)
+    }
