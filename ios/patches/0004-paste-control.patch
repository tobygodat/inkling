+    /// Paste into the focused input through its own Paste action, sent as GPUI's
+    /// standard shortcut for it (`ctrl-v` off the Mac), so the input's rules apply:
+    /// a single-line input drops a pasted newline, a read-only one ignores the paste.
+    pub fn handle_paste(&self) {
+        let event = PlatformInput::KeyDown(gpui::KeyDownEvent {
+            keystroke: gpui::Keystroke {
+                modifiers: Modifiers { control: true, ..Modifiers::default() },
+                key: "v".to_string(),
+                key_char: None,
+            },
+            is_held: false,
+            prefer_character_input: false,
+        });
+        if let Some(callback) = self.input_callback.borrow_mut().as_mut() {
+            callback(event);
+        }
+    }
