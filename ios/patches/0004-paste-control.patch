+/// A bar for the keyboard's accessory view with a system `UIPasteControl`
+/// on its trailing edge, pasting into `target`.
+///
+/// iOS refuses a programmatic read of text another app copied
+/// (`PBErrorDomain` 13, or a prompt on a device), so a paste button GPUI draws
+/// cannot paste a key copied in a browser. The system control's tap is the
+/// user's consent, so its paste needs no prompt.
+unsafe fn paste_bar(target: *mut AnyObject) -> *mut AnyObject {
+    unsafe {
+        let bar: *mut AnyObject = msg_send![class!(UIView), alloc];
+        let frame = ObjcCGRect::new(0.0, 0.0, 0.0, 52.0);
+        let bar: *mut AnyObject = msg_send![bar, initWithFrame: frame];
+        let _: () = msg_send![bar, setAutoresizingMask: 2_usize]; // flexible width
+
+        let configuration: *mut AnyObject = msg_send![class!(UIPasteControlConfiguration), new];
+        let _: () = msg_send![configuration, setDisplayMode: 0_usize]; // icon and label
+        let _: () = msg_send![configuration, setCornerStyle: 4_isize]; // capsule
+        let label: *mut AnyObject = msg_send![class!(UIColor), labelColor];
+        let background: *mut AnyObject = msg_send![class!(UIColor), systemBackgroundColor];
+        let _: () = msg_send![configuration, setBaseBackgroundColor: label];
+        let _: () = msg_send![configuration, setBaseForegroundColor: background];
+        let control: *mut AnyObject = msg_send![class!(UIPasteControl), alloc];
+        let control: *mut AnyObject = msg_send![control, initWithConfiguration: configuration];
+        let _: () = msg_send![configuration, release];
+        let _: () = msg_send![control, setTarget: target];
+        let _: () = msg_send![control, setTranslatesAutoresizingMaskIntoConstraints: false];
+        let _: () = msg_send![bar, addSubview: control];
+        let _: () = msg_send![control, release];
+
+        let pin = |a: *mut AnyObject, b: *mut AnyObject, constant: f64| {
+            let constraint: *mut AnyObject = msg_send![a, constraintEqualToAnchor: b, constant: constant];
+            let _: () = msg_send![constraint, setActive: true];
+        };
+        let control_trailing: *mut AnyObject = msg_send![control, trailingAnchor];
+        let bar_trailing: *mut AnyObject = msg_send![bar, trailingAnchor];
+        pin(control_trailing, bar_trailing, -16.0);
+        let control_center: *mut AnyObject = msg_send![control, centerYAnchor];
+        let bar_center: *mut AnyObject = msg_send![bar, centerYAnchor];
+        pin(control_center, bar_center, 0.0);
+        let height: *mut AnyObject = msg_send![control, heightAnchor];
+        let height: *mut AnyObject = msg_send![height, constraintEqualToConstant: 36.0_f64];
+        let _: () = msg_send![height, setActive: true];
+        bar
+    }
+}
